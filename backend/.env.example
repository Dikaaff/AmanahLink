[TEMPLATE]
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3104,http://localhost:3104

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AmanahLink -------------------------------------------------------------
AMANAH_PLATFORM_FEE_PERCENT=2.00
AMANAH_MIN_DONATION=10000.00
AMANAH_MAX_DONATION=1000000000.00
AMANAH_PAYMENT_DRIVER=fake
AMANAH_PAYMENT_EXPIRY_HOURS=24
AMANAH_CAMPAIGN_REFUND_WINDOW_DAYS=7
AMANAH_REQUEST_METRICS_RETENTION_HOURS=90
AMANAH_PAYMENT_WEBHOOK_SECRET=
AMANAH_PAYMENT_WEBHOOK_TOLERANCE=300
# Retry backoff in seconds (1m / 5m / 30m) before an event is dead-lettered.
AMANAH_WEBHOOK_RETRY_DELAYS=60,300,1800
AMANAH_WEBHOOK_DLQ_ALERT_DEPTH=1000

# OCR boundary (D-007). `fake` is offline and deterministic; `http` calls the
# Flask service in ocr-service/ through the fixed /extract contract.
AMANAH_OCR_DRIVER=fake
AMANAH_OCR_SERVICE_URL=http://127.0.0.1:5001
AMANAH_OCR_TIMEOUT=10
AMANAH_OCR_CONFIDENCE=0.75
AMANAH_OCR_AMOUNT_TOLERANCE=1
AMANAH_RECEIPT_MAX_BYTES=5242880
AMANAH_PROFILE_QUERIES=false
